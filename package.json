{
  "name": "injection-service",
  "version": "1.0.0",
  "description": "Blockchain-agnostic memory injection service with pluggable pricing and monetization",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "ethers": "^6.10.0",
    "stripe": "^14.0.0",
    "dotenv": "^17.2.2",
    "jsonwebtoken": "^9.1.2",
    "axios": "^1.12.0",
    "zod": "^4.1.12",
    "nanoid": "^5.1.5",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.0",
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.9.3",
    "tsx": "^4.19.1",
    "esbuild": "^0.25.0",
    "vitest": "^2.1.4",
    "prettier": "^3.6.2",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
