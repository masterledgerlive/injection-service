# Blockchain RPC Endpoints
ETHEREUM_RPC=https://eth-mainnet.alchemyapi.io/v2/YOUR_KEY
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Injector Wallet
INJECTOR_PRIVATE_KEY=0x...
INJECTOR_ADDRESS=0x...

# Payment Processing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
TOKEN_EXPIRY_HOURS=24

# Unified Indexer Connection
INDEXER_API_URL=http://localhost:3000/api
INDEXER_API_KEY=your-indexer-api-key

# Pricing Configuration
BASE_FEE_USD=0.50
DATA_RATE_PER_KB=0.10
ETHEREUM_MULTIPLIER=2.0
POLYGON_MULTIPLIER=0.1
ARBITRUM_MULTIPLIER=0.2
OPTIMISM_MULTIPLIER=0.2
BASE_MULTIPLIER=0.2

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database (optional, for storing injection records)
DATABASE_URL=postgresql://user:password@localhost:5432/injection_service

# Sentry (error tracking)
SENTRY_DSN=https://...

# Feature Flags
ENABLE_STRIPE_PAYMENTS=true
ENABLE_WEB3_PAYMENTS=true
ENABLE_BATCH_OPTIMIZATION=true
ENABLE_PLUGIN_SYSTEM=true
