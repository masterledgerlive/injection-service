# Base Sepolia (v0 default — chainId 84532). Do not default to mainnet 8453.
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Injector wallet (required to send txs). Never commit the real key.
INJECTOR_PRIVATE_KEY=
INJECTOR_ADDRESS=

# Optional mainnet RPCs — unset by default so v0 cannot spend mainnet.
# ETHEREUM_RPC=
# POLYGON_RPC=
# ARBITRUM_RPC=
# OPTIMISM_RPC=
# BASE_RPC=

# JWT
JWT_SECRET=change-me
TOKEN_EXPIRY_HOURS=24

# Pricing
BASE_FEE_USD=0.50
DATA_RATE_PER_KB=0.10
BASE_MULTIPLIER=0.2
BASE_SEPOLIA_MULTIPLIER=0.2

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
